---
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../components/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Signature from '../components/Signature.astro';
import FilmCard from '../components/FilmCard.astro';
import { SITE_META } from '../content/site/meta';
import { sortFilms, filterPublished } from '../lib/films';
import indexHeroImg from '../assets/index.hero.png';

const allFilms = await getCollection('films');
const films = sortFilms(filterPublished(allFilms));

// Astro 6 + legacy.collectionsBackwardsCompat exposes ids with the file
// extension (e.g. 'about.mdx'); look up by the bare slug across both forms.
const siteEntries = await getCollection('site');
const aboutEntry = siteEntries.find((e) => e.id.replace(/\.[^.]+$/, '') === 'about');
if (!aboutEntry) throw new Error('site/about content entry not found');
const { Content: AboutContent } = await render(aboutEntry);
---

<BaseLayout title={SITE_META.siteTitle} description={SITE_META.siteDescription} canonicalPath="/">
  <Header />

  {/* HERO — signature spans the full viewport width (no page-pad on
       this section) so the SVG can be as big as the screen. sub-label
       gets its own inline padding so it doesn't kiss the edges. */}
  <section class="hero">
    <Signature variant="block" />
    <p class="hero-sub meta meta-light">{SITE_META.heroSubLabel}</p>
  </section>

  {/* DECORATIVE — the workshop photo. NOT a work — pure decoration. */}
  <section class="hero-photo">
    <Image src={indexHeroImg} alt="" widths={[1280, 1920, 2048]} sizes="100vw" />
  </section>

  {/* Works ↓ CTA sits between the decorative photo and the index so
      it's unambiguous which side is the gallery */}
  <div class="scroll-cta">
    <a href="#works">Works ↓</a>
  </div>

  {/* WORKS */}
  <section id="works">
    <div class="section-anchor divider-top divider-bottom page-pad">
      <span>① Works · Index</span>
      <span>{String(films.length).padStart(2, '0')} / {String(films.length).padStart(2, '0')}</span>
    </div>
    {films.map((film) => <FilmCard film={film} />)}
  </section>

  {/* ABOUT */}
  <section id="info" class="about divider-top page-pad">
    <h2 class="h-section about-title">About.</h2>
    <div class="about-body">
      <AboutContent />
    </div>
    <div class="signoff">
      <div class="signoff-label meta">— signed,</div>
      <Signature variant="cursive" size="md" />
    </div>
  </section>

  {/* CONTACT */}
  <section class="contact divider-top page-pad">
    <h2 class="h-section contact-title">Let's talk.</h2>
    <ul class="contact-list">
      <li><a href={`mailto:${SITE_META.contact.email}`}><span>Email</span><span>{SITE_META.contact.email} →</span></a></li>
      <li><a href={SITE_META.contact.instagramUrl} target="_blank" rel="noreferrer noopener"><span>Instagram</span><span>{SITE_META.contact.instagramHandle} →</span></a></li>
    </ul>
  </section>

  <Footer />
</BaseLayout>

<style>
  /* Hero — signature + sub-label, centred in a restrained black canvas.
     No horizontal page-pad: the SVG signature spans full viewport
     width. .hero-sub gets its own inline padding so it doesn't touch
     the edges on narrow screens. */
  .hero {
    min-height: 65vh;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 24px;
    padding: 32px 0;
  }
  /* Sub-label overrides .meta's 11px — slightly larger reads as a
     deliberate pair with the signature. */
  .hero-sub {
    font-size: 13px;
    letter-spacing: 0.14em;
    padding-inline: var(--pad-x);
  }

  /* Works ↓ scroll cue — sits between the decorative photo and the
     gallery, so the photo above it isn't mistaken for a work. */
  .scroll-cta {
    text-align: center;
    padding: 32px 0;
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.18em;
  }
  .scroll-cta a {
    color: var(--muted);
    text-decoration: none;
    background: transparent;
    transition: color 180ms ease;
  }
  .scroll-cta a:hover {
    color: var(--text);
    background: transparent;
  }

  /* Decorative full-bleed photo — its own section now, follows the
     hero in document order. Rendered at natural aspect ratio. */
  .hero-photo :global(img) {
    width: 100%;
    height: auto;
    display: block;
  }

  /* Section anchor reuse */
  .section-anchor {
    display: flex;
    justify-content: space-between;
    padding-top: 16px;
    padding-bottom: 16px;
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--muted);
  }

  /* About — fully centered: section / title / prose / signoff */
  .about {
    padding-top: 96px;
    padding-bottom: 96px;
    text-align: center;
  }
  .about-title {
    font-size: clamp(48px, 8vw, 72px);
    margin-bottom: 48px;
  }
  .about-body {
    max-width: 52ch;
    margin: 0 auto;
    font-size: 17px;
    line-height: 1.8;
    text-align: center;
  }
  .about-body :global(p) { margin-bottom: 20px; }
  .about-body :global(p:last-child) { margin-bottom: 0; }

  .signoff {
    margin-top: 64px;
    text-align: center;
  }
  .signoff-label {
    display: block;
    margin-bottom: 8px;
  }

  @media (max-width: 640px) {
    .about { padding-top: 64px; padding-bottom: 64px; }
    .about-title { margin-bottom: 32px; }
    .signoff { margin-top: 48px; }
  }

  /* Contact */
  .contact { padding-top: 64px; padding-bottom: 64px; text-align: center; }
  .contact-title { font-size: clamp(48px, 8vw, 72px); margin-bottom: 32px; }
  .contact-list {
    list-style: none;
    border-top: 1px solid var(--divider);
    max-width: 600px;
    margin: 0 auto;
  }
  .contact-list li { border-bottom: 1px solid var(--divider); }
  .contact-list a {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 16px 12px;
    text-decoration: none;
    font-size: clamp(20px, 3vw, 24px);
    font-weight: 700;
    letter-spacing: -0.02em;
  }
  .contact-list a:hover { background: var(--text); color: var(--bg); }
</style>
