---
interface Props {
  vimeoId: string;
  vimeoHash?: string;
  title?: string;
  /** CSS aspect-ratio value, e.g. "16 / 9" or "21 / 9". Pass the
   *  real video ratio so the iframe matches it — otherwise the
   *  player letterboxes (Vimeo's letterbox can read as white).  */
  aspect?: string;
}

const { vimeoId, vimeoHash, title = 'Vimeo player', aspect = '16 / 9' } = Astro.props;

const params = new URLSearchParams({
  color: 'ffffff',
  byline: '0',
  portrait: '0',
  title: '0',
  badge: '0',
  dnt: '1',
});
if (vimeoHash) params.set('h', vimeoHash);

const src = `https://player.vimeo.com/video/${encodeURIComponent(vimeoId)}?${params.toString()}`;
---

<div class="vimeo-wrap page-pad">
  <div class="vimeo-frame" style={`aspect-ratio: ${aspect};`}>
    <iframe
      src={src}
      title={title}
      loading="lazy"
      allow="autoplay; fullscreen; picture-in-picture"
      allowfullscreen
      frameborder="0"
    ></iframe>
  </div>
</div>

<style>
  .vimeo-wrap {
    padding-top: 32px;
    padding-bottom: 32px;
    background: var(--bg);
  }
  .vimeo-frame {
    /* aspect-ratio set inline via the `aspect` prop so each film can
       use its real video ratio (16:9, 21:9 cinematic, etc.) and the
       player has no letterboxing. */
    overflow: hidden;
    background: var(--bg);
  }
  .vimeo-frame iframe {
    width: 100%;
    height: 100%;
    border: 0;
    display: block;
    background: var(--bg);
  }
</style>
