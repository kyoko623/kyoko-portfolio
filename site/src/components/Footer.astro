---
import { SITE_META } from '../content/site/meta';
---

<footer class="site-footer divider-top page-pad">
  <span>© {SITE_META.ownerName} · {SITE_META.copyrightYear}</span>
  <span>Built with Astro</span>
</footer>

<style>
  .site-footer {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-top: 24px;
    padding-bottom: 24px;
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--muted);
  }
  @media (max-width: 640px) {
    .site-footer { flex-direction: column; gap: 12px; text-align: center; }
  }
</style>
