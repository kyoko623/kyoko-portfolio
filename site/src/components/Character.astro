---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  name: string;
  image: ImageMetadata;
}

const { name, image } = Astro.props;
---

<section class="character page-pad">
  <div class="character-image">
    <Image src={image} alt={name} widths={[960, 1440, 1920, 2560]} sizes="(min-width: 1024px) 1100px, 100vw" />
  </div>
  <div class="character-text">
    <h3 class="h-card name">{name}</h3>
    <div class="body"><slot /></div>
  </div>
</section>

<style>
  /* Full-width image stacked above centered prose. The image is shown
     at its natural aspect ratio (no fixed crop) so 16:9 film stills,
     2:3 portraits, or 21:9 wide shots all render whole. */
  .character {
    padding-top: 48px;
    padding-bottom: 48px;
    text-align: center;
  }
  .character-image {
    margin-bottom: 32px;
    overflow: hidden;
    background: var(--bg);
  }
  .character-image :global(img) {
    width: 100%;
    height: auto;
    display: block;
    margin-inline: auto;
  }
  /* Wider than prose measure (60ch) — character info reads as bullet lists
     where a single dense line (e.g. "国籍 / 气质: …") can run ~50 CJK chars.
     80ch lets that fit one line on desktop while still bounded for tablet. */
  .character-text {
    max-width: 80ch;
    margin-inline: auto;
    text-align: left;
  }
  .name {
    font-size: clamp(28px, 5vw, 40px);
    margin-bottom: 24px;
    text-align: center;
  }
  .body :global(h3),
  .body :global(h4) {
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--muted);
    margin: 24px 0 10px;
    font-weight: 500;
  }
  .body :global(ul) { list-style: none; padding: 0; }
  .body :global(li) {
    font-size: 15px;
    line-height: 1.7;
    padding: 6px 0;
    border-bottom: 1px solid #222;
  }
  .body :global(li strong) { color: var(--text); }
  .body :global(li ul) { margin-top: 4px; margin-left: 16px; }
  .body :global(li li) {
    border-bottom: none;
    padding: 2px 0;
    color: #ccc;
  }
</style>
